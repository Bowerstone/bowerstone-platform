# Passwords for the development database in compose.dev.yaml.
#
# Copy this file to .env and give each line a made-up password that you use
# nowhere else. .env is ignored by Git and never committed. Compose stops with
# a message if any of these is missing or empty.

# The Postgres superuser. Used only by the container to create the roles below.
BOWERSTONE_ADMIN_PASSWORD=

# Owns the tables and runs migrations.
BOWERSTONE_OWNER_PASSWORD=

# The running engine. Owns nothing.
BOWERSTONE_APP_PASSWORD=
